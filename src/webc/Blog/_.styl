c-blog
  box-sizing border-box
  display flex
  flex-direction column
  font-weight inherit
  gap 32px
  margin auto
  max-width 800px
  padding 20px 16px 24px
  width 100%

  > header.H1Txt
    margin 6px 0

  > time
    color #999
    font-size 14px
    letter-spacing 1px
    text-align right

  > b
    display flex
    flex-direction column
    font-weight inherit
    gap 32px

    > h2
      color #333
      font-size 24px
      line-height 1.2
      margin 0
      font-variation-settings 'wght' 250
      font-weight 250

    > b
      display flex
      flex-direction column
      font-weight inherit
      gap 14px

      > h3.O
        font-size 18px
        font-weight inherit
        line-height 1.4
        margin 0

        > a
          color inherit
          text-decoration none
          transition color 0.2s ease

          &:hover
            color #0071e3

      > c-md
        display block
        font-size 14px
        font-weight inherit
        line-height 1.65

      > b
        align-items center
        color #999
        display flex
        font-weight inherit
        gap 12px
        margin-left 20px

        &::after
          background-image url('./svg/line.svg')
          background-repeat repeat-x
          content ''
          flex 1
          height 1px

        > .Btn
          border-radius 16px
          font-size 13px
          height 32px
          max-height 32px
          min-height 32px
          padding 0 14px

        > b
          font-size 13px
          font-weight inherit
          order 1
