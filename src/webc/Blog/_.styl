c-blog
  box-sizing border-box
  display flex
  flex-direction column
  font-weight inherit
  gap 32px
  margin auto
  max-width 800px
  padding 24px 16px 64px
  width 100%

  > header.H1Txt
    margin-bottom 32px

  > b
    display flex
    flex-direction column
    font-weight inherit
    gap 32px

    > h2
      color #333
      font-size 24px
      line-height 1.2
      margin 0
      font-variation-settings 'wght' 250
      font-weight 250

    > b
      display flex
      flex-direction column
      font-weight inherit
      gap 14px

      > h3.O
        font-size 18px
        font-weight inherit
        line-height 1.4
        margin 0

        > a
          color inherit
          text-decoration none
          transition color 0.2s ease

          &:hover
            color #0071e3

      > c-md
        display block
        font-size 14px
        font-weight inherit
        line-height 1.65

      > b
        align-items center
        display flex
        font-weight inherit
        justify-content space-between
        position relative
        margin-left 20px
        color #999

        &::before
          background-image url('./svg/line.svg')
          background-repeat repeat-x
          content ''
          height 1px
          inset auto 40px 16px 0
          position absolute
          z-index -1

        > .Btn
          font-size 13px
          padding 6px 14px

        > b
          font-size 13px
          font-weight inherit
