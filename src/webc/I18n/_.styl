.BtnC.lang
  margin auto

  .Ico
    background-image url('./svg/i18n.svg')

.I18n
  min-width 300px
  overflow hidden

  &>h6
    color #222
    font-size 16px
    font-weight 600
    margin 0 0 12px
    text-align center

  &>c-vs
    flex 1
    height 0
    margin-top 8px
    max-height 80dvh
    min-height 0

    &>b
      display flex
      flex-wrap wrap
      gap 6px 8px
      justify-content center

      @media (max-width 600px)
        gap 4px 6px

    .Btn
      border-radius 6px
      font-size 12px
      font-weight 300
      height 28px
      max-height 28px
      min-height 28px
      padding 0 8px

      @media (max-width 600px)
        box-shadow none
        color #333
        height auto
        max-height none
        min-height 0
        padding 2px 4px
        transform none

        &::before, &::after
          display none

        &:hover, &:active
          box-shadow none
          color #0071e3
          transform none

        &.Main
          border-bottom 1px solid currentColor
          border-radius 0
          color #000

          &:hover, &:active
            color #0071e3

dialog.Box:has(>.I18n)
  max-width 640px
