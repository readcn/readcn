body
  margin 0
  overflow hidden

.BtnC.rss
  margin auto

  .Ico
    background-image url('./svg/rss.svg')

c-site
  display flex
  height 100dvh
  inset 0
  position absolute
  width 100%

  > c-vs
    > *
      max-width 1648px

    > nav.Nav
      align-self center
      width 100%

    > main.demo
      box-sizing border-box
      display flex
      flex-direction column
      margin 0 auto 64px
      max-width 800px
      width calc(100% - 32px)
